{
  "name": "dsh-py-runner",
  "version": "0.1.0",
  "license": "MIT",
  "author": "dsh-py-runner contributors",
  "description": "VSCode-style Python run/debug console for the DSH sidebar: open a .py file, hit Run or Debug, watch the output stream live.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amzingluo/dsh-py-runner.git"
  },
  "homepage": "https://github.com/amzingluo/dsh-py-runner#readme",
  "bugs": {
    "url": "https://github.com/amzingluo/dsh-py-runner/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "python",
    "runner"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
